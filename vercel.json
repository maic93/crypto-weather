{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    },
    "api/cron/daily.py": {
      "runtime": "python3.12"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "10 0 * * *"
    }
  ]
}
